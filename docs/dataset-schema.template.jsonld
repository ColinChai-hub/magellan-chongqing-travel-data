{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": "https://magellanchongqing.com/open-data/#dataset",
  "name": "Magellan Chongqing Open Travel Data",
  "description": "Independently curated, source-linked reference data for Chongqing attractions, sample itineraries, transport and visitor FAQs.",
  "url": "https://magellanchongqing.com/open-data/",
  "sameAs": "https://github.com/ColinChai-hub/magellan-chongqing-travel-data",
  "creator": {
    "@type": "Organization",
    "name": "Magellan Chongqing Tours",
    "url": "https://magellanchongqing.com/"
  },
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "dateModified": "2026-11-14",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "keywords": [
    "Chongqing travel data",
    "Chongqing attractions",
    "Chongqing itineraries",
    "Chongqing transport",
    "China inbound tourism"
  ],
  "distribution": [
    {
      "@type": "DataDownload",
      "name": "Attractions CSV",
      "encodingFormat": "text/csv",
      "contentUrl": "https://raw.githubusercontent.com/ColinChai-hub/magellan-chongqing-travel-data/main/data/attractions.csv"
    },
    {
      "@type": "DataDownload",
      "name": "Attractions JSON",
      "encodingFormat": "application/json",
      "contentUrl": "https://raw.githubusercontent.com/ColinChai-hub/magellan-chongqing-travel-data/main/data/attractions.json"
    },
    {
      "@type": "DataDownload",
      "name": "Itineraries JSON",
      "encodingFormat": "application/json",
      "contentUrl": "https://raw.githubusercontent.com/ColinChai-hub/magellan-chongqing-travel-data/main/data/itineraries.json"
    },
    {
      "@type": "DataDownload",
      "name": "Transport CSV",
      "encodingFormat": "text/csv",
      "contentUrl": "https://raw.githubusercontent.com/ColinChai-hub/magellan-chongqing-travel-data/main/data/transport.csv"
    },
    {
      "@type": "DataDownload",
      "name": "Travel FAQs JSON",
      "encodingFormat": "application/json",
      "contentUrl": "https://raw.githubusercontent.com/ColinChai-hub/magellan-chongqing-travel-data/main/data/travel-faq.json"
    }
  ]
}
